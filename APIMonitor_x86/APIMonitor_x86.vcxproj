  <PropertyGroup><ApiMonitorPython Condition="'$(ApiMonitorPython)'==''">python</ApiMonitorPython></PropertyGroup>
  <Target Name="GenerateApiMonitorDefinitions" BeforeTargets="ClCompile">
    <Exec Command="&quot;$(ApiMonitorPython)&quot; &quot;$(ProjectDir)..\tools\api_monitor\generate_definitions.py&quot; --definitions &quot;$(ProjectDir)..\APIMonitor_x64\api_monitor_definitions.json&quot; --output &quot;$(IntDir)generated&quot; --architecture x86" />
  </Target>
  <Target Name="PublishApiMonitorDefinitions" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <MakeDir Directories="$(OutDir)profiles" />
    <Copy SourceFiles="$(ProjectDir)..\APIMonitor_x64\api_monitor_definitions.json" DestinationFiles="$(OutDir)profiles\api_monitor_definitions.json" SkipUnchangedFiles="true" />
  </Target>
  <PropertyGroup><ApiMonitorDiagnostics Condition="'$(ApiMonitorDiagnostics)'==''">0</ApiMonitorDiagnostics></PropertyGroup>
  <ItemDefinitionGroup><ClCompile><PreprocessorDefinitions>KSWORD_APIMON_DIAGNOSTICS=$(ApiMonitorDiagnostics);%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile></ItemDefinitionGroup>
