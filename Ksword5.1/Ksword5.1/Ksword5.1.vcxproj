    <Error Condition="!Exists('$(KswordLicenseSource)')" Text="KSword license file was not found: $(KswordLicenseSource)" />
    <Error Condition="!Exists('$(KswordCommunityCovenantSource)')" Text="KSword community covenant was not found: $(KswordCommunityCovenantSource)" />
    <Copy SourceFiles="$(KswordLicenseSource)" DestinationFiles="$(TargetDir)LICENSE" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(KswordCommunityCovenantSource)" DestinationFiles="$(TargetDir)COMMUNITY_COVENANT.md" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyKswordZstdLicense" AfterTargets="Build">
    <PropertyGroup>
      <KswordZstdLicenseSource>$(MSBuildProjectDirectory)\..\..\third_party\zstd\LICENSE.txt</KswordZstdLicenseSource>
      <KswordThirdPartyLicenseTargetDir>$(TargetDir)licenses\third_party\</KswordThirdPartyLicenseTargetDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(KswordZstdLicenseSource)')" Text="Zstandard license file was not found: $(KswordZstdLicenseSource)" />
    <MakeDir Directories="$(KswordThirdPartyLicenseTargetDir)" />
    <Copy SourceFiles="$(KswordZstdLicenseSource)" DestinationFiles="$(KswordThirdPartyLicenseTargetDir)zstd-LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyKswordSystemWideTransmissionNotice" AfterTargets="Build">
    <PropertyGroup>
      <KswordSystemWideTransmissionLicenseSource>$(MSBuildProjectDirectory)\..\..\third_party\SystemWideTransmission\LICENSE.txt</KswordSystemWideTransmissionLicenseSource>
      <KswordSystemWideTransmissionNoticeSource>$(MSBuildProjectDirectory)\..\..\third_party\SystemWideTransmission\NOTICE.md</KswordSystemWideTransmissionNoticeSource>
      <KswordThirdPartyLicenseTargetDir>$(TargetDir)licenses\third_party\</KswordThirdPartyLicenseTargetDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(KswordSystemWideTransmissionLicenseSource)')" Text="SystemWideTransmission license file was not found: $(KswordSystemWideTransmissionLicenseSource)" />
    <Error Condition="!Exists('$(KswordSystemWideTransmissionNoticeSource)')" Text="SystemWideTransmission notice file was not found: $(KswordSystemWideTransmissionNoticeSource)" />
    <MakeDir Directories="$(KswordThirdPartyLicenseTargetDir)" />
    <Copy SourceFiles="$(KswordSystemWideTransmissionLicenseSource)" DestinationFiles="$(KswordThirdPartyLicenseTargetDir)system-wide-transmission-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(KswordSystemWideTransmissionNoticeSource)" DestinationFiles="$(KswordThirdPartyLicenseTargetDir)system-wide-transmission-NOTICE.md" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyKswordZydisLicenses" AfterTargets="Build">
    <PropertyGroup>
      <KswordZydisLicenseSource>$(MSBuildProjectDirectory)\..\..\third_party\zydis\LICENSE-Zydis.txt</KswordZydisLicenseSource>
      <KswordZycoreLicenseSource>$(MSBuildProjectDirectory)\..\..\third_party\zydis\LICENSE-Zycore.txt</KswordZycoreLicenseSource>
      <KswordZydisNoticeSource>$(MSBuildProjectDirectory)\..\..\third_party\zydis\NOTICE.md</KswordZydisNoticeSource>
      <KswordThirdPartyLicenseTargetDir>$(TargetDir)licenses\third_party\</KswordThirdPartyLicenseTargetDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(KswordZydisLicenseSource)')" Text="Zydis license file was not found: $(KswordZydisLicenseSource)" />
    <Error Condition="!Exists('$(KswordZycoreLicenseSource)')" Text="Zycore license file was not found: $(KswordZycoreLicenseSource)" />
    <Error Condition="!Exists('$(KswordZydisNoticeSource)')" Text="Zydis notice file was not found: $(KswordZydisNoticeSource)" />
    <MakeDir Directories="$(KswordThirdPartyLicenseTargetDir)" />
    <Copy SourceFiles="$(KswordZydisLicenseSource)" DestinationFiles="$(KswordThirdPartyLicenseTargetDir)zydis-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(KswordZycoreLicenseSource)" DestinationFiles="$(KswordThirdPartyLicenseTargetDir)zycore-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(KswordZydisNoticeSource)" DestinationFiles="$(KswordThirdPartyLicenseTargetDir)zydis-NOTICE.md" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyKswordArkDynDataProfilePack" AfterTargets="Build">
    <!-- Release carries one v4 pack. Core field/EX projections are derived in memory by R3. -->
    <PropertyGroup>
      <KswordProfileCompressor>$(MSBuildProjectDirectory)\..\..\tools\compress_qt_profile_json.py</KswordProfileCompressor>
      <KswordProfilePythonExe Condition="'$(KswordProfilePythonExe)'==''">python</KswordProfilePythonExe>
      <KswordArkDynDataProfilePackV4Source>$(MSBuildProjectDirectory)\profiles\ark_dyndata_pack_v4.json</KswordArkDynDataProfilePackV4Source>
      <KswordArkDynDataProfilePackTargetDir>$(TargetDir)profiles\</KswordArkDynDataProfilePackTargetDir>
      <KswordStaleDynDataPackArchiveDir>$(TEMP)\Ksword5.1-old-offsets\$(MSBuildProjectName)-$(Configuration)-$(Platform)-$([System.DateTime]::Now.ToString('yyyyMMdd-HHmmss-fff'))\</KswordStaleDynDataPackArchiveDir>
    </PropertyGroup>
    <ItemGroup>
      <KswordStaleDynDataPack Include="$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v1.json" Condition="Exists('$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v1.json')" />
      <KswordStaleDynDataPack Include="$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v1.json.qz" Condition="Exists('$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v1.json.qz')" />
      <KswordStaleDynDataPack Include="$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v2.json" Condition="Exists('$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v2.json')" />
      <KswordStaleDynDataPack Include="$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v2.json.qz" Condition="Exists('$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v2.json.qz')" />
      <KswordStaleDynDataPack Include="$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v3.json" Condition="Exists('$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v3.json')" />
      <KswordStaleDynDataPack Include="$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v3.json.qz" Condition="Exists('$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v3.json.qz')" />
      <KswordStaleDynDataPack Include="$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v4.json" Condition="Exists('$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v4.json')" />
    </ItemGroup>
    <MakeDir Directories="$(KswordStaleDynDataPackArchiveDir)" Condition="'@(KswordStaleDynDataPack)'!=''" />
    <Move SourceFiles="@(KswordStaleDynDataPack)" DestinationFolder="$(KswordStaleDynDataPackArchiveDir)" Condition="'@(KswordStaleDynDataPack)'!=''" />
    <MakeDir Directories="$(KswordArkDynDataProfilePackTargetDir)" Condition="Exists('$(KswordArkDynDataProfilePackV4Source)')" />
    <Exec Command="&quot;$(KswordProfilePythonExe)&quot; &quot;$(KswordProfileCompressor)&quot; --file &quot;$(KswordArkDynDataProfilePackV4Source)&quot; --out &quot;$(KswordArkDynDataProfilePackTargetDir)ark_dyndata_pack_v4.json.qz&quot;" Condition="Exists('$(KswordProfileCompressor)') And Exists('$(KswordArkDynDataProfilePackV4Source)')" />
    <Warning Condition="!Exists('$(KswordProfileCompressor)')" Text="Profile compressor was not found; compressed profile packs were not generated: $(KswordProfileCompressor)" />
    <Warning Condition="!Exists('$(KswordArkDynDataProfilePackV4Source)')" Text="KswordARK DynData v4 profile pack was not found: $(KswordArkDynDataProfilePackV4Source)" />
  </Target>
  <Target Name="CopyRegistryOptimizationProfile" AfterTargets="Build">
    <!-- 系统优化页运行时优先读取 profiles\registry_optimization_items.json.qz；源文件是本地提取资产，已加入 .gitignore。 -->
    <ItemGroup>
      <KswordRegistryOptimizationAsset Include="$(MSBuildProjectDirectory)\profiles\registry_optimization_assets\**\*.*" />
    </ItemGroup>
    <PropertyGroup>
      <KswordProfileCompressor>$(MSBuildProjectDirectory)\..\..\tools\compress_qt_profile_json.py</KswordProfileCompressor>
      <KswordProfilePythonExe Condition="'$(KswordProfilePythonExe)'==''">python</KswordProfilePythonExe>
      <KswordRegistryOptimizationProfileSource>$(MSBuildProjectDirectory)\profiles\registry_optimization_items.json</KswordRegistryOptimizationProfileSource>
      <KswordRegistryOptimizationProfileTargetDir>$(TargetDir)profiles\</KswordRegistryOptimizationProfileTargetDir>
      <KswordRegistryOptimizationAssetTargetDir>$(TargetDir)profiles\registry_optimization_assets\</KswordRegistryOptimizationAssetTargetDir>
    </PropertyGroup>
    <MakeDir Directories="$(KswordRegistryOptimizationProfileTargetDir)" Condition="Exists('$(KswordRegistryOptimizationProfileSource)')" />
    <Exec Command="&quot;$(KswordProfilePythonExe)&quot; &quot;$(KswordProfileCompressor)&quot; --file &quot;$(KswordRegistryOptimizationProfileSource)&quot; --out &quot;$(KswordRegistryOptimizationProfileTargetDir)registry_optimization_items.json.qz&quot;" Condition="Exists('$(KswordProfileCompressor)') And Exists('$(KswordRegistryOptimizationProfileSource)')" />
    <Delete Files="$(KswordRegistryOptimizationProfileTargetDir)registry_optimization_items.json" Condition="Exists('$(KswordProfileCompressor)')" />
    <MakeDir Directories="$(KswordRegistryOptimizationAssetTargetDir)" Condition="'@(KswordRegistryOptimizationAsset)' != ''" />
    <Copy SourceFiles="@(KswordRegistryOptimizationAsset)" DestinationFiles="@(KswordRegistryOptimizationAsset->'$(KswordRegistryOptimizationAssetTargetDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(KswordRegistryOptimizationAsset)' != ''" />
    <Warning Condition="!Exists('$(KswordProfileCompressor)')" Text="Profile compressor was not found; registry optimization profile was not compressed: $(KswordProfileCompressor)" />
    <Warning Condition="!Exists('$(KswordRegistryOptimizationProfileSource)')" Text="Registry optimization profile was not found; System Optimization tab will show an empty profile list: $(KswordRegistryOptimizationProfileSource)" />
  </Target>
  <Target Name="CopyKswordArkPdbDeepOffsetLibraries" AfterTargets="Build">
    <!-- 深度 PDB 偏移库用于进程/线程/对象等详情页后续扩展；运行时优先读取本地 .json.qz，不依赖开发机 E: 符号缓存。 -->
    <ItemGroup>
      <KswordArkPdbDeepOffsetLibrary Include="$(MSBuildProjectDirectory)\profiles\pdb_deep_offsets\*.json" />
    </ItemGroup>
    <PropertyGroup>
      <KswordProfileCompressor>$(MSBuildProjectDirectory)\..\..\tools\compress_qt_profile_json.py</KswordProfileCompressor>
      <KswordProfilePythonExe Condition="'$(KswordProfilePythonExe)'==''">python</KswordProfilePythonExe>
      <KswordArkPdbDeepOffsetTargetDir>$(TargetDir)profiles\pdb_deep_offsets\</KswordArkPdbDeepOffsetTargetDir>
    </PropertyGroup>
    <MakeDir Directories="$(KswordArkPdbDeepOffsetTargetDir)" Condition="'@(KswordArkPdbDeepOffsetLibrary)' != ''" />
    <Exec Command="&quot;$(KswordProfilePythonExe)&quot; &quot;$(KswordProfileCompressor)&quot; --dir &quot;$(MSBuildProjectDirectory)\profiles\pdb_deep_offsets&quot; --pattern &quot;*.json&quot; --out-dir &quot;$(KswordArkPdbDeepOffsetTargetDir).&quot;" Condition="Exists('$(KswordProfileCompressor)') And '@(KswordArkPdbDeepOffsetLibrary)' != ''" />
    <Delete Files="@(KswordArkPdbDeepOffsetLibrary->'$(KswordArkPdbDeepOffsetTargetDir)%(Filename)%(Extension)')" Condition="Exists('$(KswordProfileCompressor)') And '@(KswordArkPdbDeepOffsetLibrary)' != ''" />
    <Warning Condition="!Exists('$(KswordProfileCompressor)')" Text="Profile compressor was not found; PDB deep offset libraries were not compressed: $(KswordProfileCompressor)" />
  </Target>
  <Target Name="CopyTaskmgrHijackScript" AfterTargets="Build">
    <PropertyGroup>
      <TaskmgrHijackScriptSource>$(MSBuildProjectDirectory)\..\..\TaskmgrHijack.ps1</TaskmgrHijackScriptSource>
    </PropertyGroup>
    <Copy SourceFiles="$(TaskmgrHijackScriptSource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(TaskmgrHijackScriptSource)')" />
  </Target>
  <Target Name="CopyKswordArkDriverArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <KswordArkDriverOutputDir Condition="'$(Configuration)|$(Platform)'=='Release|x64'">$(KswordUnifiedReleaseOutputDir)</KswordArkDriverOutputDir>
      <KswordArkDriverOutputDir Condition="'$(Configuration)|$(Platform)'!='Release|x64'">$(MSBuildProjectDirectory)\..\..\KswordARKDriver\x64\$(Configuration)\</KswordArkDriverOutputDir>
      <KswordArkDriverSysSource>$(KswordArkDriverOutputDir)KswordARK.sys</KswordArkDriverSysSource>
      <KswordArkDriverPdbSource>$(KswordArkDriverOutputDir)KswordARK.pdb</KswordArkDriverPdbSource>
      <KswordArkDriverInfSource>$(KswordArkDriverOutputDir)KswordARKDriver.inf</KswordArkDriverInfSource>
    </PropertyGroup>
    <Copy SourceFiles="$(KswordArkDriverSysSource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" Condition="'$(Configuration)|$(Platform)'!='Release|x64' And Exists('$(KswordArkDriverSysSource)')" />
    <Copy SourceFiles="$(KswordArkDriverPdbSource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" Condition="'$(Configuration)|$(Platform)'!='Release|x64' And Exists('$(KswordArkDriverPdbSource)')" />
    <Copy SourceFiles="$(KswordArkDriverInfSource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" Condition="'$(Configuration)|$(Platform)'!='Release|x64' And Exists('$(KswordArkDriverInfSource)')" />
    <Warning Condition="!Exists('$(KswordArkDriverSysSource)')" Text="KswordARK driver binary was not found for output sync: $(KswordArkDriverSysSource)" />
  </Target>
  <!-- 统一 Release 目录必须包含 Qt 运行库与平台插件，否则离开开发环境后主程序无法启动。 -->
  <Target Name="DeployQtRuntime" AfterTargets="Build" Condition="'$(Configuration)|$(Platform)'=='Release|x64' and Exists('$(TargetPath)')">
    <PropertyGroup>
      <KswordQtDeployExe Condition="'$(KswordQtDeployExe)'=='' and '$(KSWORD_QT_DIR)'!='' and Exists('$(KSWORD_QT_DIR)\bin\windeployqt.exe')">$(KSWORD_QT_DIR)\bin\windeployqt.exe</KswordQtDeployExe>
      <KswordQtDeployExe Condition="'$(KswordQtDeployExe)'=='' and Exists('$(MSBuildProjectDirectory)\..\..\.deps\Qt\6.9.3\msvc2022_64\bin\windeployqt.exe')">$(MSBuildProjectDirectory)\..\..\.deps\Qt\6.9.3\msvc2022_64\bin\windeployqt.exe</KswordQtDeployExe>
      <KswordQtDeployExe Condition="'$(KswordQtDeployExe)'=='' and '$(QtInstall)'!='' and Exists('$(QtInstall)\bin\windeployqt.exe')">$(QtInstall)\bin\windeployqt.exe</KswordQtDeployExe>
      <KswordQtDeployExe Condition="'$(KswordQtDeployExe)'=='' and '$(QTDIR)'!='' and Exists('$(QTDIR)\bin\windeployqt.exe')">$(QTDIR)\bin\windeployqt.exe</KswordQtDeployExe>
    </PropertyGroup>
    <Message Importance="High" Text="Deploying Qt runtime and plugins to $(TargetDir)" Condition="Exists('$(KswordQtDeployExe)')" />
    <Exec Command="&quot;$(KswordQtDeployExe)&quot; --release --force --compiler-runtime --no-opengl-sw --dir &quot;$(TargetDir).&quot; &quot;$(TargetPath)&quot;" Condition="Exists('$(KswordQtDeployExe)')" />
    <Warning Condition="!Exists('$(KswordQtDeployExe)')" Text="windeployqt.exe was not found; the Release output may be missing Qt runtime DLLs and plugins." />
  </Target>
  <!-- Qt 官方动态库由 MSVC /MD 构建，即使 Ksword5.1.exe 自身使用 /MT，也仍需把 VC 运行库 DLL 随 Release 输出部署。 -->
  <Target Name="CopyVisualCppRuntimeRedist" AfterTargets="Build" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ItemGroup>
      <KswordVisualCppRuntimeRedist Include="$(VCToolsRedistDir)x64\Microsoft.VC143.CRT\*.dll" Condition="'$(VCToolsRedistDir)' != ''" />
      <KswordVisualCppRuntimeRedist Include="$(VCInstallDir)Redist\MSVC\*\x64\Microsoft.VC143.CRT\*.dll" Condition="'$(VCInstallDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(KswordVisualCppRuntimeRedist)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(KswordVisualCppRuntimeRedist)' != ''" />
    <Warning Condition="'@(KswordVisualCppRuntimeRedist)' == ''" Text="VC++ runtime redist DLLs were not found under VCToolsRedistDir or VCInstallDir\Redist\MSVC; Qt DLLs may fail to load on machines without VC++ Redistributable installed." />
  </Target>
  <!-- Release 主程序构建完成后复用驱动测试签名证书，签名失败只告警，避免阻断普通编译。 -->
  <Target Name="KswordMainAutoTestSignAfterBuild" AfterTargets="Build" Condition="'$(Configuration)|$(Platform)'=='Release|x64' and Exists('$(TargetPath)') and '$(KswordArkSkipAutoTestSign)'!='true'">
    <PropertyGroup>
      <KswordArkSignScript>$(MSBuildProjectDirectory)\..\..\scripts\Sign-KswordArkDriverTest.ps1</KswordArkSignScript>
      <KswordArkPowerShellExe Condition="'$(KswordArkPowerShellExe)'==''">powershell</KswordArkPowerShellExe>
    </PropertyGroup>
    <Message Importance="High" Text="Ksword5.1: attempting non-fatal test-sign for $(TargetPath). Set /p:KswordArkSkipAutoTestSign=true to skip." />
    <Exec Command="&quot;$(KswordArkPowerShellExe)&quot; -ExecutionPolicy Bypass -File &quot;$(KswordArkSignScript)&quot; -TargetPath &quot;$(TargetPath)&quot; -NonFatal" ContinueOnError="WarnAndContinue" IgnoreStandardErrorWarningFormat="true" Condition="Exists('$(KswordArkSignScript)')" />
    <Warning Condition="!Exists('$(KswordArkSignScript)')" Text="Ksword5.1 auto test-sign skipped because script was not found: $(KswordArkSignScript)" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Condition="Exists('$(QtMsBuild)\qt.targets')">
    <Import Project="$(QtMsBuild)\qt.targets" Condition="Exists('$(QtMsBuild)\qt.targets')" />
  </ImportGroup>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
