  <Target Name="CopyKswordLanguagePacks" AfterTargets="Build">
    <ItemGroup>
      <KswordLanguagePack Include="$(MSBuildProjectDirectory)\languages\*.json" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)languages\" Condition="'@(KswordLanguagePack)' != ''" />
    <Copy SourceFiles="@(KswordLanguagePack)" DestinationFolder="$(TargetDir)languages\" SkipUnchangedFiles="true" Condition="'@(KswordLanguagePack)' != ''" />
    <Warning Condition="'@(KswordLanguagePack)' == ''" Text="No KSword language packs were found under $(MSBuildProjectDirectory)\languages." />
  </Target>
  <!-- Qt Advanced Docking System 必须与 MSVC/Qt 运行时保持同一 ABI，并放在 exe 同目录，避免 PATH 捡到 MinGW 同名 DLL。 -->
  <Target Name="CopyQtAdvancedDockingRuntime" AfterTargets="Build">
