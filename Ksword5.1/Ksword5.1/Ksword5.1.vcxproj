    <Error Condition="'$(QtAdvancedDockingRuntimeSource)'==''" Text="Qt Advanced Docking runtime is not configured for $(Configuration)|$(Platform)." />
    <Error Condition="!Exists('$(QtAdvancedDockingRuntimeSource)')" Text="Qt Advanced Docking runtime was not found: $(QtAdvancedDockingRuntimeSource)" />
    <Copy SourceFiles="$(QtAdvancedDockingRuntimeSource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyKswordLicenseAndCovenant" AfterTargets="Build">
