<RCC>
    <qresource prefix="/Ksword5"/>
    <qresource prefix="/Image">
        <file>Resource/Logo/MainLogo.png</file>
        <file>Resource/Logo/KswordHome-En.png</file>
        <file>Resource/Logo/KswordHome-ZH.png</file>
    </qresource>
    <qresource prefix="/Data">
        <file alias="startup_registry_locations.txt">StartupDock/startup_registry_locations.txt</file>
    </qresource>
    <qresource prefix="/Icon">
        <!-- 日志面板使用的图标资源（均来自 Resource/Icon 图标库） -->
        <file alias="log_export.svg">Resource/Icon/file/file_export_line.svg</file>
        <file alias="reg_import.svg">Resource/Icon/file/file_import_line.svg</file>
        <file alias="log_clear.svg">Resource/Icon/system/delete_2_line.svg</file>
        <file alias="log_copy.svg">Resource/Icon/file/copy_line.svg</file>
        <file alias="log_clipboard.svg">Resource/Icon/file/clipboard_line.svg</file>
        <file alias="log_track.svg">Resource/Icon/editor/list_search_line.svg</file>
        <file alias="log_cancel_track.svg">Resource/Icon/system/close_line.svg</file>
        <file alias="filter_funnel.svg">Resource/Icon/business/filter_line.svg</file>
        <file alias="plus.svg">Resource/Icon/system/plus_line.svg</file>
        <file alias="ks_control_check_white.svg">Resource/Icon/system/ks_control_check_white.svg</file>
        <file alias="ks_control_check_black.svg">Resource/Icon/system/ks_control_check_black.svg</file>
        <file alias="ks_control_dash_white.svg">Resource/Icon/system/ks_control_dash_white.svg</file>
        <file alias="ks_control_dash_black.svg">Resource/Icon/system/ks_control_dash_black.svg</file>
        <file alias="ks_control_radio_white.svg">Resource/Icon/system/ks_control_radio_white.svg</file>
        <file alias="ks_control_radio_black.svg">Resource/Icon/system/ks_control_radio_black.svg</file>
        <file alias="ks_control_down_white.svg">Resource/Icon/system/ks_control_down_white.svg</file>
        <file alias="ks_control_down_black.svg">Resource/Icon/system/ks_control_down_black.svg</file>
        <file alias="ks_control_up_white.svg">Resource/Icon/system/ks_control_up_white.svg</file>
        <file alias="ks_control_up_black.svg">Resource/Icon/system/ks_control_up_black.svg</file>
        <file alias="ks_control_up_muted.svg">Resource/Icon/system/ks_control_up_muted.svg</file>
        <file alias="ks_control_down_muted.svg">Resource/Icon/system/ks_control_down_muted.svg</file>

        <!-- 进程面板图标资源 -->
        <file alias="process_main.svg">Resource/Icon/system/process_line.svg</file>
        <file alias="process_threads.svg">Resource/Icon/logo/threads_line.svg</file>
        <file alias="process_refresh.svg">Resource/Icon/system/refresh_3_line.svg</file>
        <file alias="process_tree.svg">Resource/Icon/nature/tree_line.svg</file>
        <file alias="process_list.svg">Resource/Icon/system/scrollable_list_line.svg</file>
        <file alias="process_start.svg">Resource/Icon/media/play_line.svg</file>
        <file alias="process_pause.svg">Resource/Icon/media/pause_line.svg</file>
        <file alias="process_copy_cell.svg">Resource/Icon/file/copy_line.svg</file>
        <file alias="process_copy_row.svg">Resource/Icon/file/clipboard_line.svg</file>
        <file alias="process_terminate.svg">Resource/Icon/system/close_circle_line.svg</file>
        <file alias="process_suspend.svg">Resource/Icon/media/pause_circle_line.svg</file>
        <file alias="process_resume.svg">Resource/Icon/media/play_circle_line.svg</file>
        <file alias="service_apply.svg">Resource/Icon/system/check_line.svg</file>
