        <file alias="disk_volume.svg">Resource/Icon/design/layout_grid_line.svg</file>
        <file alias="disk_health.svg">Resource/Icon/system/heartbeat_line.svg</file>
        <file alias="disk_tools.svg">Resource/Icon/system/tool_line.svg</file>
        <file alias="desktop_switch.svg">Resource/Icon/system/switch_line.svg</file>
        <file alias="desktop_create.svg">Resource/Icon/system/add_square_line.svg</file>
        <file alias="window_picker_target.svg">Resource/Icon/business/target_line.svg</file>
        <file alias="titlebar_capture_allowed.svg">Resource/Icon/system/eye_line.svg</file>
        <file alias="titlebar_capture_protected.svg">Resource/Icon/system/eye_close_line.svg</file>
        <file alias="titlebar_pin_line.svg">Resource/Icon/file/pin_line.svg</file>
        <file alias="titlebar_pin_fill.svg">Resource/Icon/file/pin_fill.svg</file>
        <file alias="titlebar_minimize.svg">Resource/Icon/system/minimize_line.svg</file>
        <file alias="titlebar_maximize.svg">Resource/Icon/media/fullscreen_line.svg</file>
        <file alias="titlebar_restore.svg">Resource/Icon/system/restore_line.svg</file>
        <file alias="titlebar_close.svg">Resource/Icon/system/close_line.svg</file>

        <!-- 句柄面板图标资源 -->
        <file alias="handle_refresh.svg">Resource/Icon/system/refresh_3_line.svg</file>
        <file alias="handle_copy.svg">Resource/Icon/file/copy_line.svg</file>
        <file alias="handle_copy_row.svg">Resource/Icon/file/clipboard_line.svg</file>
        <file alias="handle_close.svg">Resource/Icon/system/close_circle_line.svg</file>

        <!-- 文件模块新增导航与检索图标 -->
        <file alias="file_nav_back.svg">Resource/Icon/arrow/left_line.svg</file>
        <file alias="file_nav_forward.svg">Resource/Icon/arrow/right_line.svg</file>
