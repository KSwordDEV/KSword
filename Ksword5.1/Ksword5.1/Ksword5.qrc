        <file alias="process_details.svg">Resource/Icon/file/file_info_line.svg</file>
        <file alias="process_performance.svg">Resource/Icon/development/performance_line.svg</file>
        <file alias="process_hotkey.svg">Resource/Icon/development/hotkey_line.svg</file>
        <file alias="knowledge_book.svg">Resource/Icon/education/book_2_line.svg</file>
        <file alias="sound_source.svg">Resource/Icon/device/speaker_line.svg</file>
        <file alias="system_time.svg">Resource/Icon/system/time_duration_line.svg</file>
        <file alias="virtual_location.svg">Resource/Icon/map/map_pin_line.svg</file>
        <file alias="disk_storage.svg">Resource/Icon/device/storage_line.svg</file>
