  <Target Name="KswordArkCopyCleanDriverBeforeVariantSign" BeforeTargets="KswordArkAutoVariantSignAfterBuild" Condition="'$(ConfigurationType)'=='Driver' and Exists('$(TargetPath)') and '$(KswordArkSkipAutoVariantSign)'!='true' and '$(KswordArkSkipAutoTestSign)'!='true'">
    <PropertyGroup>
