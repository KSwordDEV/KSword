      <KswordArkInfPath>$(TargetDir)KswordARKDriver.inf</KswordArkInfPath>
    </PropertyGroup>
    <MakeDir Directories="$(KswordArkMirrorDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(KswordArkMirrorDir)KswordARK.sys" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(KswordArkPdbPath)" DestinationFiles="$(KswordArkMirrorDir)KswordARK.pdb" SkipUnchangedFiles="false" Condition="Exists('$(KswordArkPdbPath)')" />
    <Copy SourceFiles="$(KswordArkInfPath)" DestinationFiles="$(KswordArkMirrorDir)KswordARKDriver.inf" SkipUnchangedFiles="false" Condition="Exists('$(KswordArkInfPath)')" />
