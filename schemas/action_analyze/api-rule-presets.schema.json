{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksword.local/schemas/action_analyze/api-rule-presets.schema.json",
  "title": "KSword API observation rule presets",
  "description": "Schema version 1 remains readable. Omitted expressionProfile preserves predicate-expr-v2 admission. Expression parsing and field binding are additionally checked by the product.",
  "type": "object",
  "required": ["schemaVersion", "presetSet", "profiles", "behaviorRules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "presetSet": { "$ref": "#/$defs/id" },
    "expressionProfile": {
      "enum": ["predicate-expr-v1", "predicate-expr-v2", "predicate-expr-v3"],
      "default": "predicate-expr-v2"
    },
    "profiles": {
      "type": "object",
      "required": ["grouped", "by-category"],
      "properties": {
        "grouped": { "$ref": "#/$defs/classificationList" },
        "by-category": { "$ref": "#/$defs/classificationList" }
      }
    },
    "behaviorRules": {
      "description": "Ordered first-match single-call rules. Parameter comparisons require Known quality; absent, clipped, ambiguous or undecodable values remain unknown. API success does not imply execution or malicious intent.",
      "type": "array", "maxItems": 128,
      "items": { "$ref": "#/$defs/behavior" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9._-]+$" },
    "text": { "type": "string", "minLength": 1 },
    "classificationList": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "$ref": "#/$defs/classification" }
    },
    "classification": {
      "type": "object",
      "required": ["ruleId", "predicate", "summary"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/id" },
        "predicate": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "summaryZh": { "$ref": "#/$defs/text" }
      },
      "not": { "required": ["evidence"] }
    },
    "behavior": {
      "description": "Own declarative observation wording. Registry pathLower is exact ASCII case folding of a decoded HKLM/HKCU root and subkey; no regex or ordinary-handle path inference. The runtime typedFields catalog defines available field sources.",
      "type": "object",
      "required": ["ruleId", "predicate", "summary"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/id" },
        "predicate": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "summaryZh": { "$ref": "#/$defs/text" },
        "evidence": {
          "enum": ["reported-api-return", "reported-executable-memory-candidate", "reported-cross-process-request"],
          "default": "reported-api-return"
        }
      }
    }
  }
}
