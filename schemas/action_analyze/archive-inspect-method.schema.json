{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksword.invalid/schemas/action_analyze/archive-inspect-method.schema.json",
  "title": "ActionAnalyze v1 archive.inspect",
  "$ref": "#/$defs/params",
  "$defs": {
    "stream": { "enum": ["raw", "records", "control"] },
    "offset": {
      "$comment": "The semantic byte bound is 1073741824 inclusive. Apply it after canonical decimal-string validation.",
      "allOf": [{ "$ref": "value.schema.json#/$defs/u64" }, { "maxLength": 10 }]
    },
    "nullableOffset": { "anyOf": [{ "$ref": "#/$defs/offset" }, { "type": "null" }] },
    "nullableU64": { "anyOf": [{ "$ref": "value.schema.json#/$defs/u64" }, { "type": "null" }] },
    "networkRecordOffset": {
      "$comment": "Stored v1 record header offsets are 176 through 1073741792 inclusive. Check the semantic range after validating the decimal string.",
      "$ref": "#/$defs/offset"
    },
    "params": { "oneOf": [{ "$ref": "#/$defs/framingParams" }, { "$ref": "#/$defs/graphParams" }, { "$ref": "#/$defs/networkParams" }] },
    "networkParams": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "sampleId", "stream", "ordinal", "view", "recordSequence", "recordOffset"],
      "properties": {
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "sampleId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "stream": { "const": "raw" },
        "ordinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "view": { "const": "network" },
        "recordSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "recordOffset": { "$ref": "#/$defs/networkRecordOffset" }
      }
    },
    "framingParams": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "sampleId", "stream", "ordinal"],
      "properties": {
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "sampleId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "stream": { "$ref": "#/$defs/stream" },
        "ordinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "endOffset": { "$ref": "#/$defs/offset" }
      }
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
    "graphParams": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "sampleId", "stream", "ordinal", "view"],
      "properties": {
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "sampleId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "stream": { "enum": ["raw", "raw-etw"] },
        "ordinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "view": { "const": "graph" },
        "afterSequence": { "$ref": "value.schema.json#/$defs/u64", "default": "0" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 },
        "expectedSha256": { "$ref": "#/$defs/hash" }
      },
      "if": { "required": ["afterSequence"], "properties": { "afterSequence": { "not": { "const": "0" } } } },
      "then": { "required": ["expectedSha256"] }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["requestedEndOffset", "fileBytes", "scanLimitBytes", "framedBytes", "blockCount", "lastBlockOrdinal", "lastSequence"],
      "properties": {
        "requestedEndOffset": { "$ref": "#/$defs/nullableOffset" },
        "fileBytes": { "$ref": "#/$defs/nullableU64" },
        "scanLimitBytes": { "$ref": "#/$defs/nullableOffset" },
        "framedBytes": { "$ref": "#/$defs/offset" },
        "blockCount": { "$ref": "value.schema.json#/$defs/u64" },
        "lastBlockOrdinal": { "$ref": "#/$defs/nullableU64" },
        "lastSequence": { "$ref": "#/$defs/nullableU64" }
      },
      "allOf": [
        {
          "if": { "properties": { "blockCount": { "const": "0" } } },
          "then": { "properties": { "lastBlockOrdinal": { "type": "null" }, "lastSequence": { "type": "null" } } },
          "else": { "properties": { "lastBlockOrdinal": { "$ref": "value.schema.json#/$defs/u64" }, "lastSequence": { "$ref": "value.schema.json#/$defs/u64" } } }
        },
        {
          "if": { "properties": { "fileBytes": { "type": "null" } } },
          "then": { "properties": { "scanLimitBytes": { "type": "null" }, "framedBytes": { "const": "0" }, "blockCount": { "const": "0" } } },
          "else": { "properties": { "scanLimitBytes": { "$ref": "#/$defs/offset" } } }
        }
      ]
    },
    "framingError": {
      "type": "object", "additionalProperties": false, "required": ["reason", "offset", "win32Error"],
      "properties": {
        "reason": { "type": "string" },
        "offset": { "$ref": "#/$defs/offset" },
        "win32Error": { "anyOf": [{ "allOf": [{ "$ref": "value.schema.json#/$defs/u32" }, { "minimum": 1 }] }, { "type": "null" }] }
      }
    },
    "result": { "oneOf": [{ "$ref": "#/$defs/framingResult" }, { "$ref": "#/$defs/graphResult" }, { "$ref": "#/$defs/networkResult" }] },
    "networkResult": {
      "type": "object", "additionalProperties": false,
      "required": ["view", "projectId", "sampleId", "stream", "ordinal", "recordSequence", "recordOffset", "verifiedBlockEnd", "sourceTrust", "metadata", "bytesHex"],
      "properties": {
        "view": { "const": "network" },
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "sampleId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "stream": { "const": "raw" },
        "ordinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "recordSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "recordOffset": { "$ref": "#/$defs/networkRecordOffset" },
        "verifiedBlockEnd": { "$ref": "#/$defs/offset" },
        "sourceTrust": { "const": "recorded-declaration" },
        "metadata": { "$ref": "network-evidence-draft.schema.json", "properties": { "record": { "const": "flow" } } },
        "bytesHex": { "type": "string", "maxLength": 131072, "pattern": "^(?:[0-9a-f]{2})*(?![\\s\\S])" }
      }
    },
    "framingResult": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "sampleId", "generation", "stream", "ordinal", "createdUtc100ns", "framingStatus", "framingError", "framingCoverage", "requiredRecordCount", "unsupportedOptionalRecords", "unsupportedRequiredRecords", "interpretedBytes", "durableBytes"],
      "properties": {
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "sampleId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "generation": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "stream": { "$ref": "#/$defs/stream" },
        "ordinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "createdUtc100ns": { "$ref": "#/$defs/nullableU64" },
        "framingStatus": { "enum": ["framing-complete", "truncated", "corrupt", "unsupported", "io-error"] },
        "framingError": { "anyOf": [{ "$ref": "#/$defs/framingError" }, { "type": "null" }] },
        "framingCoverage": { "$ref": "#/$defs/coverage" },
        "requiredRecordCount": { "$ref": "value.schema.json#/$defs/u64" },
        "unsupportedOptionalRecords": { "$ref": "value.schema.json#/$defs/u64" },
        "unsupportedRequiredRecords": { "$ref": "value.schema.json#/$defs/u64" },
        "interpretedBytes": { "type": "null" },
        "durableBytes": { "type": "null" }
      },
      "oneOf": [
        { "properties": { "framingStatus": { "const": "framing-complete" }, "framingError": { "type": "null" } } },
        { "properties": { "framingStatus": { "const": "truncated" }, "framingError": { "type": "object", "properties": { "reason": { "const": "end-of-file" }, "win32Error": { "type": "null" } } } } },
        { "properties": { "framingStatus": { "const": "corrupt" }, "framingError": { "type": "object", "properties": { "reason": { "enum": ["magic", "header-crc", "header-length", "reserved", "identity", "ordinal", "block-length", "record-count", "sequence", "qpc-range", "stored-crc", "decoded-crc", "record-length", "record-payload-crc", "segment-limit"] }, "win32Error": { "type": "null" } } } } },
        { "properties": { "framingStatus": { "const": "unsupported" }, "framingError": { "type": "object", "properties": { "reason": { "enum": ["version", "flags", "stream", "codec"] }, "win32Error": { "type": "null" } } } } },
        { "properties": { "framingStatus": { "const": "io-error" }, "framingError": { "type": "object", "properties": { "reason": { "enum": ["file-size", "file-read"] } } } } }
      ]
    },
    "graphRaw": {
      "type": "object", "additionalProperties": false,
      "required": ["segmentOrdinal", "blockOrdinal", "recordSequence", "recordOffset", "inlineOffset", "inlineBytes"],
      "properties": {
        "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "blockOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "recordSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "recordOffset": { "$ref": "#/$defs/offset" },
        "inlineOffset": { "$ref": "#/$defs/offset" },
        "inlineBytes": { "$ref": "#/$defs/offset" }
      }
    },
    "graphObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "apiFamily", "apiCategory", "headerPid", "headerTid", "actorInstance", "targetInstance", "threadInstance", "execution", "finding", "gaps", "sourceId", "sourceEpoch", "sourceGroup", "sourceSequence", "eventOrdinal", "raw"],
      "properties": {
        "operation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "apiFamily": { "description": "Stable clue family recomputed from the archived API packet." },
        "apiCategory": { "description": "API Monitor business category checked against the archived packet." },
        "headerPid": { "anyOf": [{ "$ref": "value.schema.json#/$defs/u32" }, { "type": "null" }] },
        "headerTid": { "anyOf": [{ "$ref": "value.schema.json#/$defs/u32" }, { "type": "null" }] },
        "callbackHints": {
          "type": "object", "additionalProperties": false,
          "required": ["originPid", "originTid", "targetPid", "targetTid", "notificationUtc100ns"],
          "properties": {
            "originPid": { "type": ["integer", "null"], "minimum": 1, "maximum": 4294967295 },
            "originTid": { "type": ["integer", "null"], "minimum": 1, "maximum": 4294967295 },
            "targetPid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "targetTid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "notificationUtc100ns": { "$ref": "#/$defs/nullableU64" }
          }
        },
        "actorInstance": { "type": "null" },
        "targetInstance": { "type": "null" },
        "threadInstance": { "type": "null" },
        "execution": { "type": "null" },
        "finding": { "type": "null" },
        "gaps": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["source-unverified", "legacy-summary-only", "actor-instance-unknown", "target-instance-unknown", "outcome-unknown", "actual-write-range-unknown", "thread-instance-unknown", "execution-unknown", "etw-context-only", "invalid-native-record", "source-payload-truncated"] }
        },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sourceEpoch": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sourceGroup": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sourceSequence": { "$ref": "#/$defs/nullableU64" },
        "eventOrdinal": { "type": "null" },
        "raw": { "$ref": "#/$defs/graphRaw" },
        "apiTransfer": { "$ref": "#/$defs/apiTransferFields" },
        "apiApc": { "$ref": "#/$defs/apiApcFields" },
        "apiContext": { "$ref": "#/$defs/apiContextFields" },
        "apiSectionMap": { "$ref": "#/$defs/apiSectionMapFields" }
      },
      "oneOf": [
        { "properties": { "apiFamily": { "enum": ["memory-write", "section-map"] }, "apiCategory": { "const": "memory" } } },
        { "properties": { "apiFamily": { "enum": ["thread-create", "apc-queue", "thread-context"] }, "apiCategory": { "const": "thread" } } },
        { "properties": { "apiFamily": { "type": "null" }, "apiCategory": { "type": "null" } } }
      ]
    },
    "apiTransferFields": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "actorCreationFileTime", "targetPid", "targetCreationFileTime", "targetStable", "targetTid", "targetThreadCreationFileTime", "address", "requestedBytes", "completedBytes", "requestedStartAddress", "enterQpc", "returnQpc", "inputHandle", "outcome"],
      "properties": {
        "schema": { "const": "api-injection-fields-v1" },
        "actorCreationFileTime": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "targetPid": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "targetCreationFileTime": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "targetStable": { "type": "boolean" },
        "targetTid": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "targetThreadCreationFileTime": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "address": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "requestedBytes": { "$ref": "value.schema.json#/$defs/u64" },
        "completedBytes": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "requestedStartAddress": { "$ref": "value.schema.json#/$defs/nullableU64" },
        "enterQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "returnQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "inputHandle": { "$ref": "value.schema.json#/$defs/u64" },
        "outcome": { "enum": ["succeeded", "failed", "partial", "unknown"] }
      }
    },
    "apiApcFields": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "actorCreationFileTime", "targetPid", "targetCreationFileTime", "targetTid", "targetThreadCreationFileTime", "targetStable", "requestedRoutineAddress", "enterQpc", "returnQpc", "inputThreadHandle", "argument1", "argument2", "argument3", "queueOutcome", "delivery", "execution"],
      "properties": {
        "schema": { "const": "api-apc-fields-v1" },
        "actorCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetPid": { "$ref": "#/$defs/nullableU64" },
        "targetCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetTid": { "$ref": "#/$defs/nullableU64" },
        "targetThreadCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetStable": { "type": "boolean" },
        "requestedRoutineAddress": { "$ref": "#/$defs/nullableU64" },
        "enterQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "returnQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "inputThreadHandle": { "$ref": "value.schema.json#/$defs/u64" },
        "argument1": { "$ref": "value.schema.json#/$defs/u64" },
        "argument2": { "$ref": "value.schema.json#/$defs/u64" },
        "argument3": { "$ref": "value.schema.json#/$defs/u64" },
        "queueOutcome": { "enum": ["accepted", "failed", "unknown"] },
        "delivery": { "type": "null" },
        "execution": { "type": "null" }
      }
    },
    "apiContextFields": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "actorCreationFileTime", "targetPid", "targetCreationFileTime", "targetTid", "targetThreadCreationFileTime", "targetStable", "contextFlags", "requestedIp", "requestedSp", "contextArchitecture", "enterQpc", "returnQpc", "inputThreadHandle", "inputContextAddress", "requestOutcome", "contextApplied", "execution"],
      "properties": {
        "schema": { "const": "api-context-fields-v1" },
        "actorCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetPid": { "$ref": "#/$defs/nullableU64" },
        "targetCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetTid": { "$ref": "#/$defs/nullableU64" },
        "targetThreadCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetStable": { "type": "boolean" },
        "contextFlags": { "$ref": "#/$defs/nullableU64" },
        "requestedIp": { "$ref": "#/$defs/nullableU64" },
        "requestedSp": { "$ref": "#/$defs/nullableU64" },
        "contextArchitecture": { "enum": ["32", "64"] },
        "enterQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "returnQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "inputThreadHandle": { "$ref": "value.schema.json#/$defs/u64" },
        "inputContextAddress": { "$ref": "value.schema.json#/$defs/u64" },
        "requestOutcome": { "enum": ["accepted", "failed", "unknown"] },
        "contextApplied": { "type": "null" },
        "execution": { "type": "null" }
      }
    },
    "apiSectionMapFields": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "actorCreationFileTime", "targetPid", "targetCreationFileTime", "targetStable", "requestedBase", "requestedBytes", "mappedBase", "mappedBytes", "sectionOffset", "inputSectionHandle", "inputProcessHandle", "requestedProtection", "enterQpc", "returnQpc", "mapOutcome", "sectionIdentity", "aliasPropagation", "execution"],
      "properties": {
        "schema": { "const": "api-section-map-fields-v1" },
        "actorCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetPid": { "$ref": "#/$defs/nullableU64" },
        "targetCreationFileTime": { "$ref": "#/$defs/nullableU64" },
        "targetStable": { "type": "boolean" },
        "requestedBase": { "$ref": "#/$defs/nullableU64" },
        "requestedBytes": { "$ref": "#/$defs/nullableU64" },
        "mappedBase": { "$ref": "#/$defs/nullableU64" },
        "mappedBytes": { "$ref": "#/$defs/nullableU64" },
        "sectionOffset": { "$ref": "#/$defs/nullableU64" },
        "inputSectionHandle": { "$ref": "value.schema.json#/$defs/u64" },
        "inputProcessHandle": { "$ref": "value.schema.json#/$defs/u64" },
        "requestedProtection": { "$ref": "value.schema.json#/$defs/u64" },
        "enterQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "returnQpc": { "$ref": "value.schema.json#/$defs/u64" },
        "mapOutcome": { "enum": ["accepted", "failed", "unknown"] },
        "sectionIdentity": { "type": "null" },
        "aliasPropagation": { "type": "null" },
        "execution": { "type": "null" }
      }
    },
    "apiTransferLink": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "write", "threadCreate", "actorPid", "actorCreationFileTime", "targetPid", "targetCreationFileTime", "writtenAddress", "writtenBytes", "requestedStartAddress", "execution"],
      "properties": {
        "kind": { "const": "write-to-requested-thread-entry" },
        "write": { "$ref": "#/$defs/apiTransferRaw" },
        "threadCreate": { "$ref": "#/$defs/apiTransferRaw" },
        "actorPid": { "$ref": "value.schema.json#/$defs/u32" },
        "actorCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "targetPid": { "$ref": "value.schema.json#/$defs/u32" },
        "targetCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "writtenAddress": { "$ref": "value.schema.json#/$defs/u64" },
        "writtenBytes": { "$ref": "value.schema.json#/$defs/u64" },
        "requestedStartAddress": { "$ref": "value.schema.json#/$defs/u64" },
        "execution": { "type": "null" }
      }
    },
    "apiApcTransferLink": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "write", "apcQueue", "actorPid", "actorCreationFileTime", "targetPid", "targetCreationFileTime", "targetTid", "targetThreadCreationFileTime", "writtenAddress", "writtenBytes", "requestedRoutineAddress", "queueOutcome", "delivery", "execution"],
      "properties": {
        "kind": { "const": "write-to-requested-apc-routine" },
        "write": { "$ref": "#/$defs/apiTransferRaw" },
        "apcQueue": { "$ref": "#/$defs/apiTransferRaw" },
        "actorPid": { "$ref": "value.schema.json#/$defs/u32" },
        "actorCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "targetPid": { "$ref": "value.schema.json#/$defs/u32" },
        "targetCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "targetTid": { "$ref": "value.schema.json#/$defs/u32" },
        "targetThreadCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "writtenAddress": { "$ref": "value.schema.json#/$defs/u64" },
        "writtenBytes": { "$ref": "value.schema.json#/$defs/u64" },
        "requestedRoutineAddress": { "$ref": "value.schema.json#/$defs/u64" },
        "queueOutcome": { "const": "accepted" },
        "delivery": { "type": "null" },
        "execution": { "type": "null" }
      }
    },
    "apiContextTransferLink": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "write", "context", "actorPid", "actorCreationFileTime", "targetPid", "targetCreationFileTime", "targetTid", "targetThreadCreationFileTime", "writtenAddress", "writtenBytes", "requestedIp", "requestedSp", "contextArchitecture", "requestOutcome", "contextApplied", "execution"],
      "properties": {
        "kind": { "const": "write-to-requested-context-ip" },
        "write": { "$ref": "#/$defs/apiTransferRaw" },
        "context": { "$ref": "#/$defs/apiTransferRaw" },
        "actorPid": { "$ref": "value.schema.json#/$defs/u32" },
        "actorCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "targetPid": { "$ref": "value.schema.json#/$defs/u32" },
        "targetCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "targetTid": { "$ref": "value.schema.json#/$defs/u32" },
        "targetThreadCreationFileTime": { "$ref": "value.schema.json#/$defs/u64" },
        "writtenAddress": { "$ref": "value.schema.json#/$defs/u64" },
        "writtenBytes": { "$ref": "value.schema.json#/$defs/u64" },
        "requestedIp": { "$ref": "value.schema.json#/$defs/u64" },
        "requestedSp": { "$ref": "value.schema.json#/$defs/u64" },
        "contextArchitecture": { "enum": ["32", "64"] },
        "requestOutcome": { "const": "accepted" },
        "contextApplied": { "type": "null" },
        "execution": { "type": "null" }
      }
    },
    "apiTransferRaw": {
      "type": "object", "additionalProperties": false,
      "required": ["segmentOrdinal", "recordSequence"],
      "properties": {
        "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "recordSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" }
      }
    },
    "apiTransferCandidates": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "evictedWrites", "truncated", "links"],
      "properties": {
        "count": { "$ref": "value.schema.json#/$defs/u64" },
        "evictedWrites": { "$ref": "value.schema.json#/$defs/u64" },
        "truncated": { "type": "boolean" },
        "links": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/apiTransferLink" } }
      }
    },
    "apiApcTransferCandidates": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "evictedWrites", "truncated", "links"],
      "properties": {
        "count": { "$ref": "value.schema.json#/$defs/u64" },
        "evictedWrites": { "$ref": "value.schema.json#/$defs/u64" },
        "truncated": { "type": "boolean" },
        "links": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/apiApcTransferLink" } }
      }
    },
    "apiContextTransferCandidates": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "evictedWrites", "truncated", "links"],
      "properties": {
        "count": { "$ref": "value.schema.json#/$defs/u64" },
        "evictedWrites": { "$ref": "value.schema.json#/$defs/u64" },
        "truncated": { "type": "boolean" },
        "links": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/apiContextTransferLink" } }
      }
    },
    "callbackBatch": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceEpoch", "state", "afterSequence", "maxRecords", "nextSequence", "latestSequence", "returnedCount", "lostBeforeFirst", "droppedCount"],
      "properties": {
        "sourceEpoch": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "state": { "enum": ["caught-up", "more-available", "snapshot-race"] },
        "afterSequence": { "$ref": "value.schema.json#/$defs/u64" },
        "maxRecords": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "nextSequence": { "$ref": "value.schema.json#/$defs/u64" },
        "latestSequence": { "$ref": "value.schema.json#/$defs/u64" },
        "returnedCount": { "$ref": "value.schema.json#/$defs/u64" },
        "lostBeforeFirst": { "$ref": "#/$defs/nullableU64" },
        "droppedCount": { "$ref": "#/$defs/nullableU64" }
      }
    },
    "graphResult": {
      "type": "object", "additionalProperties": false,
      "required": ["view", "projectId", "sampleId", "generation", "stream", "ordinal", "descriptionHash", "archiveSource", "sourceCoverage", "machineId", "bootId", "prefix", "finalSegment", "observationCount", "nextAfterSequence", "nodes", "relations", "observations"],
      "properties": {
        "view": { "const": "graph" },
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "sampleId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "generation": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "stream": { "enum": ["raw", "raw-etw"] },
        "ordinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "descriptionHash": { "$ref": "#/$defs/hash" },
        "archiveSource": { "enum": ["api-import", "api-follow-checkpoint", "etw-checkpoint", "ksword-callback-batch"] },
        "apiInputKind": { "enum": ["closed-jsonl", "cooperative-pipe", "legacy-unspecified", "jsonl-follow"] },
        "callbackBatch": { "$ref": "#/$defs/callbackBatch" },
        "sourceCoverage": { "const": "unknown" },
        "machineId": { "type": "null" },
        "bootId": { "type": "null" },
        "prefix": {
          "type": "object", "additionalProperties": false,
          "required": ["sha256", "endOffset", "lastBlockOrdinal", "lastSequence"],
          "properties": {
            "sha256": { "$ref": "#/$defs/hash" },
            "endOffset": { "$ref": "#/$defs/offset" },
            "lastBlockOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "lastSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" }
          }
        },
        "finalSegment": { "type": ["boolean", "null"] },
        "observationCount": { "$ref": "value.schema.json#/$defs/u64" },
        "nextAfterSequence": { "$ref": "#/$defs/nullableU64" },
        "tree": {
          "type": "object", "additionalProperties": false,
          "required": ["unresolvedCandidates", "contextObservations"],
          "properties": {
            "unresolvedCandidates": { "$ref": "#/$defs/graphTreeSequences" },
            "contextObservations": { "$ref": "#/$defs/graphTreeSequences" }
          }
        },
        "nodes": { "const": [] },
        "relations": { "const": [] },
        "observations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/graphObservation" } },
        "apiTransferCandidates": { "$ref": "#/$defs/apiTransferCandidates" },
        "apiApcTransferCandidates": { "$ref": "#/$defs/apiApcTransferCandidates" },
        "apiContextTransferCandidates": { "$ref": "#/$defs/apiContextTransferCandidates" }
      },
      "if": { "properties": { "archiveSource": { "const": "etw-checkpoint" } } },
         "then": { "properties": {
          "apiInputKind": false,
           "callbackBatch": false,
           "apiTransferCandidates": false,
           "apiApcTransferCandidates": false,
           "apiContextTransferCandidates": false,
         "finalSegment": { "type": "boolean" },
         "observations": { "items": { "properties": { "apiFamily": { "type": "null" }, "callbackHints": false, "apiTransfer": false, "apiApc": false, "apiContext": false, "apiSectionMap": false } } }
      } },
      "else": {
        "properties": { "stream": { "const": "raw" } },
        "if": { "properties": { "archiveSource": { "const": "ksword-callback-batch" } } },
         "then": { "required": ["callbackBatch"], "properties": {
           "apiInputKind": false,
           "apiTransferCandidates": false,
           "apiApcTransferCandidates": false,
           "apiContextTransferCandidates": false,
           "ordinal": { "const": "1" }, "finalSegment": { "type": "null" },
          "observations": { "items": {
            "required": ["callbackHints"], "properties": {
              "operation": { "const": "callback.thread.create.v1" },
              "sourceId": { "const": "kswordark.callback" }, "sourceGroup": { "const": "kswordark.callback" },
              "sourceSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
              "apiFamily": { "type": "null" }, "headerPid": { "type": "null" }, "headerTid": { "type": "null" },
               "apiTransfer": false,
               "apiApc": false,
               "apiContext": false,
               "apiSectionMap": false
            }
          } }
        } },
        "else": {
           "properties": { "callbackBatch": false, "observations": { "items": { "properties": { "apiFamily": { "type": "string" }, "callbackHints": false } } } },
          "if": { "properties": { "archiveSource": { "const": "api-follow-checkpoint" } } },
            "then": { "properties": { "finalSegment": { "type": "boolean" }, "apiInputKind": { "enum": ["jsonl-follow", "cooperative-pipe"] } } },
           "else": { "properties": { "finalSegment": { "type": "null" },
             "apiInputKind": { "enum": ["closed-jsonl", "cooperative-pipe", "legacy-unspecified"] } } }
        }
      }
    },
    "graphTreeSequences": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": { "$ref": "value.schema.json#/$defs/nonzeroU64" }
    },
    "error": {
      "oneOf": [
        {
          "$ref": "request-message.schema.json#/$defs/projectError",
          "properties": { "errorId": { "enum": ["invalid-params", "project-not-open", "project-id-mismatch", "project-data-not-found", "project-unsafe-path", "project-corrupt", "project-limit-exceeded", "project-unsupported", "project-io-error", "stale-revision", "response-too-large"] } }
        },
        {
          "$ref": "request-message.schema.json#/$defs/error",
          "properties": {
            "errorId": { "enum": ["archive-stream-unavailable", "archive-segment-unavailable"] },
            "byteOffset": { "type": "null" }
          },
          "if": { "properties": { "source": { "const": "cli" } } },
          "then": { "properties": { "code": { "const": 5 } } },
          "else": { "properties": { "code": { "minimum": 1 } } }
        }
      ]
    }
  }
}
