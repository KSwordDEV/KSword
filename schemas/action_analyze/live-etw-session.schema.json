{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksword.invalid/schemas/action_analyze/live-etw-session.schema.json",
  "title": "ActionAnalyze v1 passive session methods",
  "$ref": "#/$defs/request",
  "$defs": {
    "uuid": { "$ref": "request.schema.json#/$defs/projectUuid" },
    "u64": { "$ref": "value.schema.json#/$defs/u64" },
    "nullableU64": { "type": ["string", "null"], "if": { "type": "string" }, "then": { "$ref": "#/$defs/u64" } },
    "nativeCode": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967295 },
    "session": {
      "type": "object", "additionalProperties": false, "required": ["id", "epoch"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "epoch": { "$ref": "#/$defs/uuid" } }
    },
    "openParams": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "title", "pid", "creationFileTime", "providerId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/uuid" },
        "title": { "$ref": "request.schema.json#/$defs/projectTitle" },
        "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "creationFileTime": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "providerId": { "$ref": "#/$defs/uuid", "not": { "const": "5770385f-c22a-43e0-bf4c-06f5698ffbd9" } },
        "durationMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
      }
    },
    "openApiArchiveParams": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "title", "pid", "creationFileTime", "apiArchive"],
      "properties": {
        "projectId": { "$ref": "#/$defs/uuid" },
        "title": { "$ref": "request.schema.json#/$defs/projectTitle" },
        "pid": { "$ref": "#/$defs/openParams/properties/pid" },
        "creationFileTime": { "$ref": "#/$defs/openParams/properties/creationFileTime" },
        "durationMs": { "$ref": "#/$defs/openParams/properties/durationMs" },
        "providerId": { "const": "d4a71ada-81b0-4b15-a173-417f33bc8107" },
        "apiArchive": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sessionIdentity", "authorized"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "sessionIdentity": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "authorized": { "const": true }
          }
        }
      }
    },
    "request": {
      "$ref": "request.schema.json#/$defs/liveEnvelope",
      "properties": { "method": { "enum": ["session.open", "session.query", "session.findings", "session.stop", "session.close"] } },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "session.open" } } },
          "then": {
            "required": ["expected"],
            "properties": {
              "session": false,
              "params": { "oneOf": [{ "$ref": "#/$defs/openParams" }, { "$ref": "#/$defs/openApiArchiveParams" }] },
              "expected": {
                "type": "object", "additionalProperties": false, "required": ["revisionId"],
                "properties": { "revisionId": { "$ref": "#/$defs/uuid" } }
              }
            }
          },
          "else": {
            "required": ["session"],
            "properties": {
              "session": { "$ref": "request.schema.json#/$defs/liveSessionIdentity" },
              "params": { "$ref": "request.schema.json#/$defs/empty" }
            }
          }
        },
        {
          "if": { "properties": { "method": { "enum": ["session.query", "session.findings"] } } },
          "then": { "properties": { "expected": false } }
        },
        {
          "if": { "properties": { "method": { "enum": ["session.stop", "session.close"] } } },
          "then": {
            "required": ["expected"],
            "properties": {
              "expected": {
                "type": "object", "additionalProperties": false, "required": ["stateRevision"],
                "properties": { "stateRevision": { "$ref": "#/$defs/u64" } }
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["session", "projectId", "sampleId", "stateRevision", "capture", "stopReason", "plan", "source", "archive"],
      "properties": {
        "session": { "$ref": "#/$defs/session" },
        "projectId": { "$ref": "#/$defs/uuid" },
        "sampleId": { "$ref": "#/$defs/uuid" },
        "stateRevision": { "enum": ["1", "2", "3"] },
        "capture": { "enum": ["active", "cleanup-pending", "stopped", "partial"] },
        "stopReason": { "type": ["string", "null"] },
        "plan": { "oneOf": [{ "$ref": "#/$defs/plan" }, { "$ref": "#/$defs/apiArchivePlan" }] },
        "source": {},
        "archive": {},
        "readiness": { "$ref": "#/$defs/apiArchiveReadiness" },
        "rules": { "$ref": "#/$defs/apiArchiveRules" },
        "etw": {
          "type": "object", "additionalProperties": false, "required": ["rawStream", "plan", "source", "archive"],
          "properties": {
            "rawStream": { "const": "raw-etw" },
            "plan": { "$ref": "#/$defs/plan", "required": ["mixedEtw"] },
            "source": { "$ref": "#/$defs/source" },
            "archive": { "$ref": "#/$defs/archive" }
          }
        }
      },
      "dependentRequired": { "etw": ["readiness", "rules"] },
      "allOf": [{
        "if": { "properties": { "plan": { "required": ["mixedEtw"] } } },
        "then": { "required": ["etw"] },
        "else": { "properties": { "etw": false } }
      }],
      "if": { "properties": { "plan": { "properties": { "kind": { "const": "api-archive-follow-plan-v1" } } } } },
      "then": { "properties": { "source": { "$ref": "#/$defs/apiArchiveSource" }, "archive": { "$ref": "#/$defs/apiArchiveReport" } } },
      "else": { "properties": { "source": { "$ref": "#/$defs/source" }, "archive": { "$ref": "#/$defs/archive" }, "readiness": false, "rules": false } }
    },
    "apiArchiveReadiness": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "hooksInstalledSourceSequence", "firstRaw"],
      "properties": {
        "state": { "enum": ["awaiting-attach", "attached", "observed", "stopped-no-match", "source-interrupted", "archive-interrupted"] },
        "hooksInstalledSourceSequence": { "$ref": "#/$defs/apiArchiveSourceDiagnosis/$defs/sequence" },
        "firstRaw": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["segmentOrdinal", "rawSequence", "sourceSequence"],
          "properties": {
            "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "rawSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "sourceSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" }
          }
        }
      }
    },
    "apiArchiveRules": {
      "type": "object", "additionalProperties": false,
      "required": ["presetSet", "profile", "coverage", "state", "matchedRows", "latest"],
      "properties": {
        "presetSet": { "const": "ksword.api.behavior-presets.v1" },
        "profile": { "const": "by-category" },
        "coverage": { "const": "unknown" },
        "state": { "enum": ["ready", "evaluation-failed"] },
        "matchedRows": { "$ref": "#/$defs/u64" },
        "latest": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["ruleId", "segmentOrdinal", "rawSequence", "sourceSequence"],
          "properties": {
            "ruleId": { "type": "string" },
            "behavior": {
              "type": "object", "additionalProperties": false,
              "required": ["ruleId", "evidence", "summary"],
              "properties": {
                "ruleId": { "const": "ksword.behavior.memory-write-access-denied-return.v1" },
                "evidence": { "const": "reported-api-return" },
                "summary": { "type": "string", "minLength": 1 }
              }
            },
            "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "rawSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "sourceSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" }
          }
        }
      }
    },
    "apiArchivePlan": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "projectId", "session", "revisionId", "snapshotId", "revisionHash", "configSemanticHash", "sourceEpoch", "file", "readerPid", "readerCreation100ns", "sessionIdentity", "durationMs", "identity"],
      "properties": {
        "kind": { "const": "api-archive-follow-plan-v1" }, "projectId": { "$ref": "#/$defs/uuid" },
        "session": { "$ref": "#/$defs/session" }, "revisionId": { "$ref": "#/$defs/uuid" },
        "snapshotId": { "$ref": "#/$defs/uuid" }, "sourceEpoch": { "$ref": "#/$defs/uuid" },
        "revisionHash": { "$ref": "#/$defs/plan/properties/revisionHash" },
        "configSemanticHash": { "$ref": "#/$defs/plan/properties/configSemanticHash" },
        "readerPid": { "$ref": "#/$defs/openParams/properties/pid" },
        "readerCreation100ns": { "$ref": "#/$defs/openParams/properties/creationFileTime" },
        "sessionIdentity": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "durationMs": { "$ref": "#/$defs/plan/properties/durationMs" },
        "identity": { "const": "archive-consistency-only" },
        "checkpointRequired": { "const": true },
        "mixedEtw": { "const": true },
        "rulePresetSet": { "const": "ksword.api.behavior-presets.v1" },
        "file": {
          "type": "object", "additionalProperties": false,
          "required": ["volumeSerial", "fileId", "initialVisibleBytes"],
          "properties": {
            "volumeSerial": { "$ref": "#/$defs/u64" }, "fileId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "initialVisibleBytes": { "$ref": "#/$defs/u64" }
          }
        }
      }
    },
    "apiArchiveSource": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "state", "readerPid", "readerCreation100ns", "sessionIdentity", "identity", "validatedRows", "validatedBytes", "visibleBytes", "clueRows", "reportedAgentDrops", "cutoffBytes", "cutoffReached", "partialLineBytes", "writerReceipt", "coverage", "win32Error", "latestClue"],
      "properties": {
        "kind": { "const": "passive-api-archive" },
        "state": { "enum": ["unopened", "reading", "at-tail", "partial-line", "sealed", "unconfirmed-end", "truncated-tail", "writer-failed", "receipt-mismatch", "source-changed", "identity-mismatch", "invalid-record", "read-failed", "cutoff", "unknown"] },
        "readerPid": { "$ref": "#/$defs/apiArchivePlan/properties/readerPid" },
        "readerCreation100ns": { "$ref": "#/$defs/apiArchivePlan/properties/readerCreation100ns" },
        "sessionIdentity": { "$ref": "#/$defs/apiArchivePlan/properties/sessionIdentity" },
        "identity": { "const": "archive-consistency-only" },
        "validatedRows": { "$ref": "#/$defs/u64" }, "validatedBytes": { "$ref": "#/$defs/u64" },
        "visibleBytes": { "$ref": "#/$defs/nullableU64" }, "clueRows": { "$ref": "#/$defs/u64" },
        "reportedAgentDrops": { "$ref": "#/$defs/nullableU64" }, "cutoffBytes": { "$ref": "#/$defs/nullableU64" },
        "cutoffReached": { "type": "boolean" }, "partialLineBytes": { "$ref": "#/$defs/u64" },
        "writerReceipt": { "type": "null" }, "coverage": { "const": "unknown" },
        "win32Error": { "$ref": "value.schema.json#/$defs/u32" },
        "latestClue": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["api", "family", "sourceSequence", "rawVerified"],
          "properties": {
            "api": { "type": "string" }, "family": { "type": "string" },
            "sourceSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" }, "rawVerified": { "type": "boolean" }
          }
        },
        "diagnosis": { "$ref": "#/$defs/apiArchiveSourceDiagnosis" }
      }
    },
    "apiArchiveSourceDiagnosis": {
      "description": "仅用于实时回执。源行号指向文件中已核验的历史声明。",
      "type": "object", "additionalProperties": false,
      "required": ["input", "prefixIdentity", "producerConnection", "sessionReadySequence", "captureNotice", "captureNoticeSequence", "partialNoticeSequence", "agentLoss"],
      "$defs": {
        "sequence": { "oneOf": [{ "type": "null" }, { "$ref": "value.schema.json#/$defs/nonzeroU64" }] }
      },
      "properties": {
        "input": {
          "enum": ["unopened", "awaiting-first-read", "reading", "idle-at-tail", "waiting-for-line-end", "stopped-before-cutoff", "cutoff", "cutoff-partial-line", "sealed", "unconfirmed-end", "truncated-tail", "writer-failed", "receipt-mismatch", "source-changed", "identity-mismatch", "invalid-record", "device-disconnected", "read-failed", "unknown"]
        },
        "prefixIdentity": { "enum": ["unverified", "prefix-consistent"] },
        "producerConnection": { "const": "unknown" },
        "sessionReadySequence": {
          "description": "最近一次历史握手声明的源行号。",
          "$ref": "#/$defs/apiArchiveSourceDiagnosis/$defs/sequence"
        },
        "captureNotice": {
          "enum": [null, "HooksInstalled", "HooksPaused", "HooksResumed", "HooksRemoved", "HooksPauseFailed", "HooksResumeFailed", "InstallHooksFailed", "InstallHooksCancelled"]
        },
        "captureNoticeSequence": { "$ref": "#/$defs/apiArchiveSourceDiagnosis/$defs/sequence" },
        "partialNoticeSequence": { "$ref": "#/$defs/apiArchiveSourceDiagnosis/$defs/sequence" },
        "agentLoss": { "enum": ["unknown", "zero-reported", "loss-reported"] }
      }
    },
    "apiArchiveReport": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "segmentOrdinal", "recordedRows", "pendingRows", "queueDropped", "unconfirmedRows", "lastSequence", "flushedBytes", "error", "win32Error"],
      "properties": {
        "status": { "enum": ["pending", "raw-verified", "failed"] },
        "segmentOrdinal": { "$ref": "#/$defs/u64" },
        "recordedRows": { "$ref": "#/$defs/u64" }, "pendingRows": { "$ref": "#/$defs/u64" },
        "queueDropped": { "const": "0" }, "unconfirmedRows": { "$ref": "#/$defs/u64" },
        "lastSequence": { "$ref": "#/$defs/nullableU64" }, "flushedBytes": { "$ref": "#/$defs/nullableU64" },
        "error": { "type": ["string", "null"] }, "win32Error": { "$ref": "value.schema.json#/$defs/u32" }
      }
    },
    "closeReceipt": {
      "type": "object", "additionalProperties": false, "required": ["session", "sampleId", "stateRevision", "closed"],
      "properties": {
        "session": { "$ref": "#/$defs/session" }, "sampleId": { "$ref": "#/$defs/uuid" },
        "stateRevision": { "const": "4" }, "closed": { "const": true }
      }
    },
    "findingsReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["session", "sampleId", "state", "source", "observations", "latest"],
      "properties": {
        "session": { "$ref": "#/$defs/session" }, "sampleId": { "$ref": "#/$defs/uuid" },
        "state": { "enum": ["not-configured", "ready", "evaluation-failed"] },
        "observations": { "$ref": "#/$defs/u64" },
        "source": { "enum": [null, "api-archive-follow"] },
        "latest": { "$ref": "#/$defs/apiArchiveRules/properties/latest" }
      },
      "if": { "properties": { "source": { "type": "null" } } },
      "then": { "properties": { "state": { "const": "not-configured" }, "observations": { "const": "0" }, "latest": { "type": "null" } } },
      "else": { "properties": { "state": { "enum": ["ready", "evaluation-failed"] } } }
    },
    "archive": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "segmentOrdinal", "flushedBytes", "lastSequence", "error", "win32Error"],
      "properties": {
        "status": { "enum": ["pending", "raw-verified", "failed"] },
        "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "recordedObservations": { "$ref": "#/$defs/u64" },
        "flushedBytes": { "$ref": "#/$defs/nullableU64" }, "lastSequence": { "$ref": "#/$defs/nullableU64" },
        "error": { "type": ["string", "null"] }, "win32Error": { "$ref": "#/$defs/nativeCode" },
        "checkpoint": {
          "type": "object", "additionalProperties": false, "required": ["status", "error"],
          "properties": {
            "status": { "enum": ["pending", "raw-unavailable", "verified", "failed"] },
            "error": { "type": ["string", "null"] }
          }
        }
      }
    },
    "archivedCapture": {
      "oneOf": [
        { "$ref": "#/$defs/archivedApiFollow" },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "requestedOrdinal", "api", "etw"],
          "properties": {
            "kind": { "const": "mixed-api-etw" },
            "requestedOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "api": { "$ref": "#/$defs/mixedReadbackSource", "properties": { "stream": { "const": "raw" } } },
            "etw": { "$ref": "#/$defs/mixedReadbackSource", "properties": { "stream": { "const": "raw-etw" } } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": { "status": { "enum": ["missing", "unavailable", "limit-exceeded", "unrecognized", "invalid"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "checkpoint"],
          "properties": { "status": { "const": "invalid" }, "checkpoint": { "const": "invalid" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "segmentOrdinal", "checkedBytes", "observationCount", "plan", "terminal"],
          "properties": {
            "status": { "const": "readback-verified" },
            "checkpoint": { "const": "verified" },
            "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "finalSegment": { "type": "boolean" },
            "checkedBytes": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "observationCount": { "$ref": "#/$defs/u64" },
            "plan": {
              "type": "object", "additionalProperties": false,
              "required": ["providerId", "sourceEpoch", "headerPid", "processCreationFileTime"],
              "properties": {
                "providerId": { "$ref": "#/$defs/uuid" }, "sourceEpoch": { "$ref": "#/$defs/uuid" },
                "headerPid": { "$ref": "#/$defs/openParams/properties/pid" },
                "processCreationFileTime": { "$ref": "#/$defs/openParams/properties/creationFileTime" }
              }
            },
            "terminal": {
              "type": "object", "additionalProperties": false, "required": ["stopReason", "nativeSessionStopped"],
              "properties": {
                "stopReason": { "type": "string", "minLength": 1, "maxLength": 64 },
                "nativeSessionStopped": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "mixedReadbackSource": {
      "type": "object", "required": ["stream", "status"],
      "properties": {
        "status": { "enum": ["readback-verified", "pending", "missing", "unavailable", "limit-exceeded", "unrecognized", "invalid"] },
        "firstObservation": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["segmentOrdinal", "rawSequence"],
          "properties": {
            "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "rawSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "sourceSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" }
          }
        }
      }
    },
    "archivedApiFollow": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "status", "requestedOrdinal", "failedOrdinal", "lastVerifiedOrdinal", "lastSourceSequence"],
          "properties": {
            "kind": { "const": "api-archive-follow" },
            "status": { "enum": ["legacy-unpublished", "pending", "missing", "unavailable", "limit-exceeded", "invalid"] },
            "requestedOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "failedOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "lastVerifiedOrdinal": { "$ref": "#/$defs/u64" },
            "lastSourceSequence": { "$ref": "#/$defs/u64" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "status", "checkpoint", "segmentOrdinal", "checkedBytes", "blockOrdinal", "planRawSequence", "lastSequence", "sha256", "previousSourceSequence", "lastSourceSequence", "finalSegment", "sourceCoverage", "terminal"],
          "if": { "properties": { "finalSegment": { "const": true } } },
          "then": { "properties": { "terminal": { "type": "object" } } },
          "else": { "properties": { "terminal": { "type": "null" } } },
          "properties": {
            "kind": { "const": "api-archive-follow" },
            "status": { "const": "readback-verified" },
            "checkpoint": { "const": "verified" },
            "segmentOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "checkedBytes": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "blockOrdinal": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "planRawSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "lastSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "previousSourceSequence": { "$ref": "#/$defs/u64" },
            "lastSourceSequence": { "$ref": "#/$defs/u64" },
            "finalSegment": { "type": "boolean" },
            "sourceCoverage": { "const": "unknown" },
            "terminal": {
              "type": ["object", "null"], "additionalProperties": false,
              "required": ["stopReason", "sourceState", "sourceCutoffReached", "partialLineBytes"],
              "properties": {
                "stopReason": { "type": "string", "minLength": 1, "maxLength": 64 },
                "sourceState": { "$ref": "#/$defs/apiArchiveSource/properties/state" },
                "sourceCutoffReached": { "type": "boolean" },
                "partialLineBytes": { "$ref": "#/$defs/u64" }
              }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "backend", "session", "sourceEpoch", "revisionId", "snapshotId", "revisionHash", "configSemanticHash", "providerId", "headerPid", "processCreationFileTime", "durationMs", "headerRole", "sourceClock", "receiveClock", "maxRecords", "maxPayloadBytes"],
      "properties": {
        "kind": { "const": "etw-capture-plan-v1" }, "backend": { "const": "r3" },
        "session": { "$ref": "#/$defs/session" }, "sourceEpoch": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/uuid" }] },
        "revisionId": { "$ref": "#/$defs/uuid" }, "snapshotId": { "$ref": "#/$defs/uuid" },
        "revisionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "configSemanticHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "providerId": { "$ref": "#/$defs/uuid" }, "headerPid": { "$ref": "#/$defs/openParams/properties/pid" },
        "processCreationFileTime": { "$ref": "#/$defs/openParams/properties/creationFileTime" },
        "durationMs": { "oneOf": [{ "const": 0 }, { "$ref": "#/$defs/openParams/properties/durationMs" }] },
        "segmented": { "const": true, "description": "Use per-segment observation counts while preserving the requested duration. Missing on legacy continuous plans." },
        "headerPidFilters": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/openParams/properties/pid" } },
        "targetScope": { "const": "registered-process-header-hints" },
        "headerRole": { "const": "record-context" }, "sourceClock": { "const": "filetime-100ns" },
        "receiveClock": { "const": "local-qpc" }, "maxRecords": { "const": 512 }, "maxPayloadBytes": { "const": 4096 },
        "mixedEtw": { "const": true }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
