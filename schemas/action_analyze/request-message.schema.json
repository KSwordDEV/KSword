{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksword.invalid/schemas/action_analyze/request-message.schema.json",
  "title": "ActionAnalyze v1 offline JSONL output",
  "type": "object",
  "required": ["schemaVersion", "type", "controllerId", "streamSequence"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "controllerId": { "type": "string", "pattern": "^aa-[1-9][0-9]{0,9}-[1-9][0-9]{0,19}(?![\\s\\S])" },
    "streamSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" }
  },
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/protocolError" },
    { "$ref": "#/$defs/summary" }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "helloResult": {
      "type": "object", "additionalProperties": false,
      "required": ["selectedVersion"],
      "properties": { "selectedVersion": { "const": 1 } }
    },
    "shutdownResult": {
      "type": "object", "additionalProperties": false,
      "required": ["shutdown"],
      "properties": { "shutdown": { "const": true } }
    },
    "projectHash": {
      "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "projectError": {
      "allOf": [
        { "$ref": "#/$defs/error" },
        {
          "properties": {
            "errorId": {
              "enum": [
                "invalid-params", "project-already-open", "project-not-open", "project-data-not-found",
                "project-already-exists", "project-read-only", "project-writer-busy", "stale-revision",
                "project-unsupported", "project-recovery-required", "project-unsafe-path", "project-corrupt",
                "project-limit-exceeded", "project-io-error", "project-id-mismatch", "stale-generation", "response-too-large"
              ]
            },
            "byteOffset": { "type": "null" }
          }
        }
      ],
      "if": { "properties": { "source": { "const": "cli" } } },
      "then": {
        "oneOf": [
          { "properties": { "code": { "const": 1 }, "errorId": { "enum": ["invalid-params", "project-already-open", "project-not-open", "project-already-exists", "project-read-only", "stale-revision", "project-unsafe-path", "project-id-mismatch", "stale-generation"] } } },
          { "properties": { "code": { "const": 3 }, "errorId": { "enum": ["project-io-error", "project-writer-busy"] } } },
          { "properties": { "code": { "const": 4 }, "errorId": { "const": "project-corrupt" } } },
          { "properties": { "code": { "const": 5 }, "errorId": { "enum": ["project-data-not-found", "project-unsupported"] } } },
          { "properties": { "code": { "const": 6 }, "errorId": { "enum": ["project-recovery-required", "project-limit-exceeded", "response-too-large"] } } }
        ]
      },
      "else": { "properties": { "code": { "minimum": 1 } } }
    },
    "projectResult": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "createdUtc", "settings", "revisionId", "revisionHash", "configSemanticHash", "generation", "sampleCount", "access", "recoveredPrevious", "primaryFailure"],
      "properties": {
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "createdUtc": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "settings": { "$ref": "request.schema.json#/$defs/projectSettings" },
        "revisionId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "revisionHash": { "$ref": "#/$defs/projectHash" },
        "configSemanticHash": { "$ref": "#/$defs/projectHash" },
        "generation": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "sampleCount": { "$ref": "value.schema.json#/$defs/u64" },
        "access": { "$ref": "request.schema.json#/$defs/projectAccess" },
        "recoveredPrevious": { "type": "boolean" },
        "primaryFailure": { "anyOf": [{ "$ref": "#/$defs/projectError" }, { "type": "null" }] }
      },
      "if": { "properties": { "recoveredPrevious": { "const": true } } },
      "then": { "properties": { "access": { "const": "read-only" }, "primaryFailure": { "$ref": "#/$defs/projectError" } } },
      "else": { "properties": { "primaryFailure": { "type": "null" } } }
    },
    "projectCloseResult": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "closed"],
      "properties": { "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" }, "closed": { "const": true } }
    },
    "sampleFields": {
      "type": "object",
      "required": ["sampleId", "title", "createdUtc", "revisionId", "snapshotId", "descriptionHash", "status"],
      "properties": {
        "sampleId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "title": { "$ref": "request.schema.json#/$defs/projectTitle" },
        "createdUtc": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "revisionId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "snapshotId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "descriptionHash": { "$ref": "#/$defs/projectHash" },
        "status": { "const": "not-collected" }
      }
    },
    "sampleResult": {
      "$ref": "#/$defs/sampleFields", "unevaluatedProperties": false,
      "required": ["projectId", "generation", "frozenSettings", "revisionHash", "configSemanticHash"],
      "properties": {
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "generation": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "frozenSettings": { "$ref": "request.schema.json#/$defs/projectSettings" },
        "revisionHash": { "$ref": "#/$defs/projectHash" },
        "captureArchive": { "$ref": "live-etw-session.schema.json#/$defs/archivedCapture" },
        "configSemanticHash": { "$ref": "#/$defs/projectHash" }
      }
    },
    "sampleCreateResult": {
      "$ref": "#/$defs/sampleResult",
      "properties": { "captureArchive": false }
    },
    "sampleRow": { "$ref": "#/$defs/sampleFields", "unevaluatedProperties": false },
    "samplePageResult": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "generation", "start", "sampleCount", "nextStart", "samples"],
      "properties": {
        "projectId": { "$ref": "request.schema.json#/$defs/projectUuid" },
        "generation": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "start": { "$ref": "value.schema.json#/$defs/u64" },
        "sampleCount": { "$ref": "value.schema.json#/$defs/u64" },
        "nextStart": { "anyOf": [{ "$ref": "value.schema.json#/$defs/nonzeroU64" }, { "type": "null" }] },
        "samples": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/sampleRow" } }
      }
    },
    "hello": {
      "required": ["capabilities"],
      "properties": { "type": { "const": "hello" }, "capabilities": { "$ref": "#/$defs/capabilities" } }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "projectStorage", "archives", "nativeCapture", "callerProcessMonitoring", "schemaVersions", "methods", "limits"],
      "properties": {
        "backend": { "const": "offline" },
        "projectStorage": { "type": "boolean" },
        "archives": { "type": "boolean" },
        "nativeCapture": { "const": false },
        "callerProcessMonitoring": { "const": "not-monitored" },
        "schemaVersions": { "const": [1] },
        "methods": {
          "type": "array", "minItems": 3, "maxItems": 12, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["method", "repl", "summary"],
            "properties": {
              "method": { "$ref": "request.schema.json#/$defs/token" },
              "repl": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["inputLineBytes", "outputFrameBytes", "jsonDepth", "objectKeys", "arrayItems", "requestIdBytes", "replayEntries", "pendingOutputFrames", "outputTimeoutMs"],
          "properties": {
            "inputLineBytes": { "const": 1048576 },
            "outputFrameBytes": { "const": 262144 },
            "jsonDepth": { "const": 32 },
            "objectKeys": { "const": 128 },
            "arrayItems": { "const": 4096 },
            "requestIdBytes": { "const": 128 },
            "replayEntries": { "const": 4096 },
            "replayBytes": { "const": 33554432 },
            "pendingOutputFrames": { "const": 16 },
            "outputTimeoutMs": { "const": 5000 }
          }
        }
      },
      "if": { "properties": { "projectStorage": { "const": true } } },
      "then": { "properties": { "limits": { "required": ["replayBytes"] } } },
      "else": { "properties": { "archives": { "const": false }, "methods": { "maxItems": 3 }, "limits": { "not": { "required": ["replayBytes"] } } } },
      "allOf": [{
        "if": { "properties": { "archives": { "const": true } } },
        "then": { "properties": { "methods": { "contains": { "properties": { "method": { "const": "archive.inspect" }, "repl": { "const": "archive inspect" } } }, "maxContains": 1 } } },
        "else": { "properties": { "methods": { "maxItems": 11, "not": { "contains": { "properties": { "method": { "const": "archive.inspect" } } } } } } }
      }]
    },
    "response": {
      "required": ["requestId", "phase", "effectPhase", "result", "error"],
      "properties": {
        "type": { "const": "response" },
        "requestId": { "$ref": "request.schema.json#/$defs/token" },
        "phase": { "const": "completed" },
        "effectPhase": { "enum": ["not-applicable", "observed"] },
        "result": { "type": ["object", "null"] },
        "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
      },
      "if": { "properties": { "error": { "type": "null" } } },
      "then": { "properties": { "result": { "type": "object" } } },
      "else": { "properties": { "result": { "type": "null" }, "effectPhase": { "const": "not-applicable" } } }
    },
    "protocolError": {
      "required": ["requestId", "inputSequence", "error"],
      "properties": {
        "type": { "const": "protocolError" },
        "requestId": { "type": "null" },
        "inputSequence": { "$ref": "value.schema.json#/$defs/nonzeroU64" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "summary": {
      "required": ["reason", "exitCode", "clean", "liveSession", "archive", "unresolvedResponsibilities", "error"],
      "properties": {
        "type": { "const": "summary" },
        "reason": { "enum": ["eof", "shutdown", "ctrl-break", "protocol-failed", "input-failed", "internal-error"] },
        "exitCode": { "enum": [0, 1, 3, 6] },
        "clean": { "const": true },
        "liveSession": { "type": "null" },
        "archive": { "type": "null" },
        "unresolvedResponsibilities": { "const": [] },
        "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "reason": { "enum": ["eof", "shutdown"] } } }, "then": { "properties": { "exitCode": { "const": 0 }, "error": { "type": "null" } } } },
        { "if": { "properties": { "reason": { "const": "ctrl-break" } } }, "then": { "properties": { "exitCode": { "const": 6 }, "error": { "type": "null" } } } },
        { "if": { "properties": { "reason": { "const": "protocol-failed" } } }, "then": { "properties": { "exitCode": { "const": 1 }, "error": { "$ref": "#/$defs/error" } } } },
        { "if": { "properties": { "reason": { "enum": ["input-failed", "internal-error"] } } }, "then": { "properties": { "exitCode": { "const": 3 }, "error": { "$ref": "#/$defs/error" } } } }
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["errorId", "message", "source", "code", "retryability", "stage", "byteOffset"],
      "properties": {
        "errorId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])" },
        "message": { "type": "string", "minLength": 1 },
        "source": { "enum": ["cli", "win32"] },
        "code": { "$ref": "value.schema.json#/$defs/u32" },
        "retryability": { "const": "none" },
        "stage": { "const": "offline" },
        "byteOffset": { "type": ["integer", "null"], "minimum": 0, "maximum": 1048577 }
      }
    }
  }
}
