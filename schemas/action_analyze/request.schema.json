{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksword.invalid/schemas/action_analyze/request.schema.json",
  "title": "ActionAnalyze v1 offline request envelope",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "envelope": {
      "$comment": "After framing, lexical checks, and envelope validation, select the closed parameter schema from method-catalog.json. Method presence and availability are dispatch decisions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "method", "params"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "requestId": { "$ref": "#/$defs/token" },
        "method": { "$ref": "#/$defs/token" },
        "params": { "type": "object", "maxProperties": 128 }
      }
    },
    "liveEnvelope": {
      "$comment": "Use only when a live profile is explicitly selected. The selected method defines which fields are required and the closed expected and params shapes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "method", "params"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "requestId": { "$ref": "#/$defs/token" },
        "method": { "$ref": "#/$defs/token" },
        "session": { "$ref": "#/$defs/liveSessionIdentity" },
        "expected": { "type": "object", "maxProperties": 128 },
        "params": { "type": "object", "maxProperties": 128 }
      }
    },
    "liveSessionIdentity": {
      "type": "object", "additionalProperties": false, "required": ["id", "epoch"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "epoch": { "$ref": "#/$defs/token" }
      }
    },
    "token": {
      "$comment": "The lexical pass also checks the encoded length in UTF-8 bytes.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000-\u001f\u007f]+(?![\\s\\S])"
    },
    "empty": { "type": "object", "additionalProperties": false },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptVersions"],
      "properties": {
        "acceptVersions": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "allOf": [{ "$ref": "value.schema.json#/$defs/u32" }, { "minimum": 1 }] }
        }
      }
    },
    "projectOpen": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": { "path": { "$ref": "#/$defs/projectPath" }, "access": { "$ref": "#/$defs/projectAccess" } }
    },
    "projectPath": { "type": "string", "minLength": 1, "pattern": "^[^\u0000]+(?![\\s\\S])" },
    "projectAccess": { "enum": ["read-only", "read-write"] },
    "projectUuid": {
      "allOf": [{ "$ref": "value.schema.json#/$defs/uuid" }, { "not": { "const": "00000000-0000-0000-0000-000000000000" } }]
    },
    "projectTitle": {
      "$comment": "Apply the maximum to the decoded UTF-8 bytes as well.",
      "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\u0000-\u001f]+(?![\\s\\S])"
    },
    "projectSettings": {
      "type": "object", "additionalProperties": false, "required": ["title", "notes"],
      "properties": {
        "title": { "$ref": "#/$defs/projectTitle" },
        "notes": {
          "$comment": "Apply the maximum to the decoded UTF-8 bytes as well.",
          "type": "string", "maxLength": 65536, "pattern": "^[^\u0000-\u0008\u000b-\u001f]*(?![\\s\\S])"
        }
      }
    },
    "projectCreate": {
      "type": "object", "additionalProperties": false, "required": ["path", "settings"],
      "properties": { "path": { "$ref": "#/$defs/projectPath" }, "settings": { "$ref": "#/$defs/projectSettings" } }
    },
    "projectSave": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "expectedRevisionId", "settings"],
      "properties": {
        "projectId": { "$ref": "#/$defs/projectUuid" },
        "expectedRevisionId": { "$ref": "#/$defs/projectUuid" },
        "settings": { "$ref": "#/$defs/projectSettings" }
      }
    },
    "projectIdentity": {
      "type": "object", "additionalProperties": false, "required": ["projectId"],
      "properties": { "projectId": { "$ref": "#/$defs/projectUuid" } }
    },
    "sampleIdentity": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "sampleId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/projectUuid" },
        "sampleId": { "$ref": "#/$defs/projectUuid" }
      }
    },
    "sampleQuery": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "sampleId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/projectUuid" },
        "sampleId": { "$ref": "#/$defs/projectUuid" },
        "includeCapture": { "type": "boolean" }
      }
    },
    "sampleCreate": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "expectedRevisionId", "title"],
      "properties": {
        "projectId": { "$ref": "#/$defs/projectUuid" },
        "expectedRevisionId": { "$ref": "#/$defs/projectUuid" },
        "title": { "$ref": "#/$defs/projectTitle" }
      }
    },
    "sampleList": {
      "type": "object", "additionalProperties": false, "required": ["projectId"],
      "dependentRequired": { "start": ["generation"] },
      "properties": {
        "projectId": { "$ref": "#/$defs/projectUuid" },
        "generation": { "$ref": "value.schema.json#/$defs/u64" },
        "start": { "$ref": "value.schema.json#/$defs/u64" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    }
  }
}
