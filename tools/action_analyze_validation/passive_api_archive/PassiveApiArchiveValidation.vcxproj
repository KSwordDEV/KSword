<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 独立无窗口夹具，复用正式 JSON 解析器和原包分类。 -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{4538803C-F940-46EC-B1C1-DB029114A290}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <IntDir>$(MSBuildProjectDirectory)\x64\Release\</IntDir>
    <TargetName>PassiveApiArchiveValidation</TargetName>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <LinkIncremental>false</LinkIncremental>
    <VcpkgEnabled>false</VcpkgEnabled>
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
  </PropertyGroup>
  <Import Project="..\..\..\Ksword.ReleaseOutput.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="PassiveApiArchiveValidation.cpp" />
    <ClCompile Include="..\..\..\shared\evidence\PassiveApiArchiveTail.cpp" />
    <ClCompile Include="..\..\..\shared\evidence\EvidenceJson.cpp" />
    <ClCompile Include="..\..\..\shared\evidence\LosslessValue.cpp" />
    <ClInclude Include="..\..\..\shared\evidence\PassiveApiArchiveTail.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="PrintTestBuildPaths" BeforeTargets="ClCompile">
    <Message Importance="High" Text="INTDIR=$([System.IO.Path]::GetFullPath('$(IntDir)'))" />
    <Message Importance="High" Text="OUTDIR=$([System.IO.Path]::GetFullPath('$(OutDir)'))" />
    <Message Importance="High" Text="HOSTX64=$(VCToolsInstallDir)bin\HostX64\x64\cl.exe" />
    <Error Condition="'$(PreferredToolArchitecture)' != 'x64' or !Exists('$(VCToolsInstallDir)bin\HostX64\x64\cl.exe')" Text="HostX64 is required." />
  </Target>
</Project>
