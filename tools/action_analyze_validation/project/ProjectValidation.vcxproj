<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{0A73F39D-AF47-4A6A-89F9-D9AA3B192871}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType><PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries><CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <IntDir>$(MSBuildProjectDirectory)\x64\Release\</IntDir>
    <TargetName>ActionAnalyzeProjectValidation</TargetName><PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <LinkIncremental>false</LinkIncremental><VcpkgApplocalDeps>false</VcpkgApplocalDeps><VcpkgEnabled>false</VcpkgEnabled>
    <Repo>$(MSBuildProjectDirectory)\..\..\..</Repo>
    <ProjectSource>$(Repo)\KswordCLI\ActionAnalyze\Project</ProjectSource>
  </PropertyGroup>
  <Import Project="..\..\..\Ksword.ReleaseOutput.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel><TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp20</LanguageStandard><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary><Optimization>MaxSpeed</Optimization>
      <PrecompiledHeader>NotUsing</PrecompiledHeader><DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link><SubSystem>Console</SubSystem><GenerateDebugInformation>true</GenerateDebugInformation></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="ProjectValidation.cpp" />
    <ClCompile Include="$(ProjectSource)\ProjectDocument.cpp" />
    <ClCompile Include="$(ProjectSource)\ProjectLock.cpp" />
    <ClCompile Include="$(ProjectSource)\ProjectStorage.cpp" />
    <ClCompile Include="$(ProjectSource)\SampleCatalog.cpp" />
    <ClCompile Include="$(Repo)\shared\evidence\EvidenceJson.cpp" />
    <ClCompile Include="$(Repo)\shared\evidence\LosslessValue.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="PrintProjectTestBuildPaths" BeforeTargets="ClCompile">
    <Message Importance="High" Text="PROJECT_TEST_INTDIR=$([System.IO.Path]::GetFullPath('$(IntDir)'))" />
    <Message Importance="High" Text="PROJECT_TEST_OUTDIR=$([System.IO.Path]::GetFullPath('$(OutDir)'))" />
    <Message Importance="High" Text="PROJECT_TEST_COMPILER=$(VCToolsInstallDir)bin\HostX64\x64\cl.exe" />
    <Error Condition="'$(PreferredToolArchitecture)' != 'x64' or !Exists('$(VCToolsInstallDir)bin\HostX64\x64\cl.exe')" Text="HostX64 is required." />
  </Target>
</Project>
