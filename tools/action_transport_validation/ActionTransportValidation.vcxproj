  <ItemGroup><ClCompile Include="ActionTransportValidation.cpp" /></ItemGroup>
  <ItemGroup><ClInclude Include="ActionTransportValidation.h" /></ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="PrintTransportBuildPaths" BeforeTargets="ClCompile">
    <Message Importance="High" Text="TRANSPORT_INTDIR=$([System.IO.Path]::GetFullPath('$(IntDir)'))" />
