  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="StartupProbe.cpp" /><ClInclude Include="ProbeStages.h" /></ItemGroup>
  <Import Project="$(VCTargetsPath)Microsoft.Cpp.targets" />
  <Target Name="PrintStartupProbePaths" BeforeTargets="ClCompile">
    <Message Importance="High" Text="PROBE_INTDIR=$([System.IO.Path]::GetFullPath('$(IntDir)'))" />
